#!/usr/bin/env bash
# Set wallpaper with pscircle, convert, and awww

# Make sure programs are installed
for cmd in pscircle awww awww-daemon convert timeout pidof; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "$cmd not installed" >&2
    exit 1
  fi
done

# Wallpaper settings
display=HDMI-A-1
background=~/.config/sway/wallpapers/gemini.svg
width=3840
height=2160

# Render the background once at the target resolution.
tmp_dir=$(mktemp -d) || exit 1
trap 'rm -rf -- "$tmp_dir"' EXIT
background_png="$tmp_dir/background.png"
wallpaper="$tmp_dir/wallpaper.png"
convert -background none "$background" -resize "${width}x${height}!" "$background_png" || exit 1

# Generate wallpaper
generate_wallpaper() {
  ps -e -o pid,ppid,pcpu,rss,comm --no-headers \
    | pscircle --stdin=1 \
      --output="$1" \
      --output-width=$width \
      --output-height=$height \
      --max-children=40 \
      --tree-radius-increment=10,150,100,80 \
      --scale=1.75 \
      --max-proc-name-len=10 \
      --root-label-angle=0 \
      --dot-radius=3 \
      --link-width=1.2 \
      --link-convexity=0.5 \
      --collapse-threads=true \
      --tree-font-size=10 \
      --toplists-font-size=10 \
      --toplists-bar-width=30 \
      --toplists-row-height=15 \
      --toplists-bar-height=3 \
      --cpulist-center=750.0:-60.0 \
      --memlist-center=750.0:60.0 \
      --tree-font-face=Hack \
      --tree-font-color=A89984FF \
      --toplists-font-face=Hack \
      --toplists-font-color=A89984FF \
      --toplists-pid-font-color=A89984FF \
      --background-color=282828FF \
      --background-image="$background_png" \
      --dot-color-min=427B58FF \
      --dot-color-max=8EC07CFF \
      --dot-border-color-min=00000000 \
      --dot-border-color-max=00000000 \
      --link-color-min=427B58FF \
      --link-color-max=8EC07CFF \
      --toplists-bar-background=3C383600 \
      --toplists-bar-color=A8998400 \
      --cpu-min-value=0 \
      --cpu-max-value=0.001 \
      --cpulist-name=cpu \
      --memlist-name=mem \
      --memory-min-value=10 \
      --memory-max-value=104857600 # 1024 * 1024 * 100
}

awww-daemon --no-cache >/dev/null 2>&1 &
if ! timeout 5s bash -c 'until awww query >/dev/null 2>&1; do sleep 0.1; done'; then
  echo "awww-daemon did not become ready within 5 seconds" >&2
  exit 1
fi

while pidof awww-daemon &>/dev/null; do
  if generate_wallpaper "$wallpaper"; then
    awww img --outputs "$display" --transition-type none "$wallpaper"
  else
    echo "Failed to generate wallpaper" >&2
  fi
  sleep 10
done
