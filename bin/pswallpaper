#!/usr/bin/env bash
# Set wallpaper with pscircle, convert, and awww

# Make sure programs are installed
for i in pscircle awww convert; do
  if ! command -v $i &>/dev/null; then
    echo "$i not installed"
    exit 1
  fi
done

# Get arguments
display=HDMI-A-1
background=~/.config/sway/wallpapers/gemini.svg
width=3840
height=2160

# Render the background once at the target resolution.
background_png=/tmp/wallpaper.png
background_tmp=$(mktemp /tmp/pswallpaper-bg.XXXXXX) || exit 1
if ! convert -background none "$background" -resize "${width}x${height}!" "png:$background_tmp" ||
   ! mv -fT -- "$background_tmp" "$background_png"; then
  rm -f -- "$background_tmp"
  exit 1
fi
trap 'rm -f -- "$background_png"' EXIT

# Generate wallpaper
function gen {
  ps -e -o pid,ppid,pcpu,rss,comm --no-headers \
    | pscircle --stdin=1 \
      --output=$1 \
      --output-width=$width \
      --output-height=$height \
      --max-children=40 \
      --tree-radius-increment=10,150,100,80 \
      --scale=1.75 \
      --max-proc-name-len=10 \
      --root-label-angle=0 \
      --dot-radius=3 \
      --link-width=1.2 \
      --link-convexity=0.5 \
      --collapse-threads=true \
      --tree-font-size=10 \
      --toplists-font-size=10 \
      --toplists-bar-width=30 \
      --toplists-row-height=15 \
      --toplists-bar-height=3 \
      --cpulist-center=750.0:-60.0 \
      --memlist-center=750.0:60.0 \
      --tree-font-face=Hack \
      --tree-font-color=A89984FF \
      --toplists-font-face=Hack \
      --toplists-font-color=A89984FF \
      --toplists-pid-font-color=A89984FF \
      --background-color=282828FF \
      --background-image="$background_png" \
      --dot-color-min=427B58FF \
      --dot-color-max=8EC07CFF \
      --dot-border-color-min=00000000 \
      --dot-border-color-max=00000000 \
      --link-color-min=427B58FF \
      --link-color-max=8EC07CFF \
      --toplists-bar-background=3C383600 \
      --toplists-bar-color=A8998400 \
      --cpu-min-value=0 \
      --cpu-max-value=0.001 \
      --cpulist-name=cpu \
      --memlist-name=mem \
      --memory-min-value=10 \
      --memory-max-value=104857600 # 1024 * 1024 * 100
}

awww-daemon --no-cache &
while true
do
  # Break when awww-daemon is no longer running
  if ! pidof awww-daemon &>/dev/null; then
    break
  fi

  # Generate wallpaper
  wallpaper=$(mktemp /tmp/pswallpaper_XXXXX)
  gen $wallpaper
  awww img --outputs $display --transition-type none $wallpaper
  rm $wallpaper
  sleep 10
done
